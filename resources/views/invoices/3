<script>
$(document).ready(function() {
    // Initialize DataTable with server-side processing
    var table = $('#invoicesTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '/invoices/data',
            type: 'GET',
            data: function(d) {
                d.period_filter = $('#periodFilter').val();
                d.status_filter = $('#statusFilter').val();
                d.section_filter = $('#sectionFilter').val();
            },
            error: function(xhr, error, thrown) {
                console.error('DataTables Ajax Error:', error, thrown);
                alert('حدث خطأ في تحميل البيانات. يرجى المحاولة مرة أخرى.');
            }
        },
        columns: [
            { 
                data: 'es_id', 
                render: function(data) {
                    return '<strong>' + data + '</strong>';
                }
            },
            { data: 'invoice_date' },
            { data: 'travel_date' },
            { data: 'vendor_names' },
            { data: 'beneficiary_name' },
            { 
                data: 'total_net_price',
                render: function(data) {
                    return '<strong>' + parseFloat(data).toLocaleString() + ' ج.م</strong>';
                }
            },
            { 
                data: 'total_bought_price',
                render: function(data) {
                    return '<strong>' + parseFloat(data).toLocaleString() + ' ج.م</strong>';
                }
            },
            { 
                data: 'invoice_money_pay',
                render: function(data) {
                    return '<span style="color: #10b981; font-weight: bold;">' + parseFloat(data).toLocaleString() + ' ج.م</span>';
                }
            },
            { 
                data: null,
                render: function(data) {
                    return (data.from_location || 'غير محدد') + ' / ' + (data.to_location || 'غير محدد');
                }
            },
            { data: 'passenger_names' },
            { 
                data: null,
                render: function(data) {
                    return 'أرقام الحجز: ' + data.booking_ids + '<br>أرقام التذاكر: ' + data.ticket_ids;
                }
            },
            { 
                data: 'profit',
                render: function(data) {
                    return '<span style="color: #059669; font-weight: bold;">' + parseFloat(data).toLocaleString() + ' ج.م</span>';
                }
            },
            { data: 'invoice_type' },
            { 
                data: 'payment_status',
                render: function(data) {
                    var statusTexts = {
                        '0': 'غير مدفوعة',
                        '1': 'مدفوعة جزئياً', 
                        '2': 'مدفوعة بالكامل'
                    };
                    var statusClasses = {
                        '0': 'status-0',
                        '1': 'status-1',
                        '2': 'status-2'
                    };
                    return '<span class="status-badge ' + statusClasses[data] + '">' + statusTexts[data] + '</span>';
                }
            },
            { 
                data: null,
                render: function(data) {
                    var isConfirmed = (data.invoice_status == 1);
                    var statusClass = isConfirmed ? 'confirmed' : 'unconfirmed';
                    var statusText = isConfirmed ? 'مؤكدة' : 'غير مؤكدة';
                    var statusIcon = isConfirmed ? 'ri-checkbox-circle-line' : 'ri-time-line';
                    
                    return '<button class="confirm-status-btn ' + statusClass + '" onclick="toggleConfirmStatus(' + data.id + ', ' + (!isConfirmed) + ')">' +
                           '<i class="' + statusIcon + '"></i> ' + statusText +
                           '</button>';
                }
            },
            { data: 'employee_name' },
            { 
                data: null,
                render: function(data) {
                    return createActionDropdown(data);
                }
            }
        ],
        language: {
            url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json'
        },
        order: [[1, 'desc']],
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
        drawCallback: function(settings) {
            updateStatistics();
        }
    });

    // Filter change handlers
    $('#periodFilter, #statusFilter, #sectionFilter').on('change', function() {
        table.ajax.reload();
    });

    // Refresh button
    $('#refreshBtn').on('click', function() {
        table.ajax.reload();
    });

    // Update statistics based on current table data
    function updateStatistics() {
        var info = table.page.info();
        $('#totalInvoices').text(info.recordsDisplay.toLocaleString());
        
        // You can enhance this to calculate specific statistics from the current data
        // For now, we'll use placeholder values
        $('#unpaidInvoices').text('0');
        $('#partialInvoices').text('0');
        $('#paidInvoices').text('0');
    }
});

// Toggle confirm status function
async function toggleConfirmStatus(invoiceId, newStatus) {
    try {
        const response = await fetch('/invoices/toggle-confirm', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
            },
            body: JSON.stringify({
                invoice_id: invoiceId,
                status: newStatus ? 1 : 0
            })
        });

        const result = await response.json();

        if (result.success) {
            // Reload the table to reflect changes
            $('#invoicesTable').DataTable().ajax.reload(null, false);
            
            // Show success message
            alert(result.message);
        } else {
            throw new Error(result.message || 'حدث خطأ في تحديث حالة الفاتورة');
        }
    } catch (error) {
        console.error('Toggle confirm status error:', error);
        alert('حدث خطأ في تحديث حالة الفاتورة: ' + error.message);
    }
}

// Create action dropdown
function createActionDropdown(invoice) {
    return `
        <div class="actions-dropdown">
            <button class="actions-btn" onclick="this.nextElementSibling.classList.toggle('show')">
                <i class="ri-more-2-line"></i>
                الإجراءات
            </button>
            <div class="dropdown-menu">
                <a href="/invoices/${invoice.id}/show" class="dropdown-item">
                    <i class="ri-eye-line"></i>
                    عرض التفاصيل
                </a>
                <a href="/invoices/${invoice.id}/edit" class="dropdown-item">
                    <i class="ri-edit-box-line"></i>
                    تعديل الفاتورة
                </a>
                <a href="/invoices/pay-part/${invoice.id}" class="dropdown-item text-success">
                    <i class="ri-wallet-3-line"></i>
                    سداد الفاتورة
                </a>
                <a href="/invoices/reissue/${invoice.es_id}" class="dropdown-item">
                    <i class="ri-arrow-go-forward-line"></i>
                    إعادة إصدار
                </a>
                <a href="/invoices/remove/${invoice.es_id}" class="dropdown-item text-danger" 
                   onclick="return confirm('هل أنت متأكد من حذف هذه الفاتورة؟')">
                    <i class="ri-delete-bin-line"></i>
                    حذف الفاتورة
                </a>
            </div>
        </div>
    `;
}

// Close dropdowns when clicking outside
$(document).on('click', function(e) {
    $('.dropdown-menu.show').removeClass('show');
});
</script>

